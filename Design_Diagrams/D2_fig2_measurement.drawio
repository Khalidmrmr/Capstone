<mxfile host="app.diagrams.net"><diagram name="Fig D2-2: Body measurement state machine (L2 Perception, algorithm A3)" id="D2_fig2_measurement"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1480" pageHeight="1025"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hdr" value="&lt;b&gt;Smart Closet Mirror — Fig D2-2: Body measurement state machine (L2 Perception, algorithm A3)&lt;/b&gt;&lt;br&gt;Goal: Turn a Gen 1 Mirror into a closet mirror that measures the user with a Kinect, shows their own clothes and shop items on their body, and tells them what to wear today and whether a new piece is worth buying." style="text;align=left;verticalAlign=top;fontSize=16;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1420" height="90" as="geometry"/></mxCell><mxCell id="legend" value="" style="rounded=0;fillColor=#FFFFFF;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;fontSize=12;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="890" width="1440" height="114" as="geometry"/></mxCell><mxCell id="region" value="Measuring session (one user)" style="rounded=1;arcSize=4;dashed=1;dashPattern=12 7;fillColor=none;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;fontStyle=1;fontSize=14;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="300" y="180" width="1150" height="480" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;fillColor=#000000;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="365" width="22" height="22" as="geometry"/></mxCell><mxCell id="idle" value="&lt;b&gt;Idle&lt;/b&gt;" style="rounded=1;arcSize=20;fillColor=#FFFFFF;strokeWidth=2;fontSize=13;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wr