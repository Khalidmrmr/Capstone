<mxfile host="app.diagrams.net"><diagram name="Fig D2-5: Camera capture consent state machine (L8 + L1, US-04)" id="D2_fig5_camera_consent"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1480" pageHeight="930"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hdr" value="&lt;b&gt;Smart Closet Mirror — Fig D2-5: Camera capture consent state machine (L8 + L1, US-04)&lt;/b&gt;&lt;br&gt;Goal: Turn a Gen 1 Mirror into a closet mirror that measures the user with a Kinect, shows their own clothes and shop items on their body, and tells them what to wear today and whether a new piece is worth buying." style="text;align=left;verticalAlign=top;fontSize=16;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1420" height="90" as="geometry"/></mxCell><mxCell id="legend" value="" style="rounded=0;fillColor=#FFFFFF;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;fontSize=12;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="770" width="1440" height="114" as="geometry"/></mxCell><mxCell id="region" value="Camera state verified by L1 (capture.status, I27)" style="rounded=1;arcSize=4;dashed=1;dashPattern=12 7;fillColor=none;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;fontStyle=1;fontSize=14;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="300" y="180" width="1150" height="380" as="geometry"/></mxCell><mxCell id="lg5" value="" style="rounded=1;arcSize=4;dashed=1;dashPattern=12 7;fillColor=none;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;fontStyle=1;fontSize=14;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="973.3333333333334" y="844" width="64" height="24" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;fillColor=#000000;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="345" width="22" height="22" as="geometry"/></mxCell><mxCell id="off" value="&lt;b&gt;Off&lt;/b&gt;&lt;br&gt;indicator &amp;#x27;Camera off&amp;#x27;&lt;br&gt;Kinect closed, LED off" style="rounded=1;arcSize=20;fillColor=#FFFFFF;strokeWidth=2;fontSize=13;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="340" y="320" width="230" height="82" as="geometry"/></mxCell><mxCell id="ask" value="&lt;b&gt;Asking&lt;/b&gt;&lt;br&gt;&amp;#x27;Allow the camera for&lt;br&gt;this session?&amp;#x27;" style="rounded=1;arcSize=20;fillColor=#FFFFFF;strokeWidth=2;fontSize=13;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="760" y="320" width="230" height="82" as="geometry"/></mxCell><mxCell id="on" value="&lt;b&gt;On&lt;/b&gt;&lt;br&gt;indicator &amp;#x27;Camera on&amp;#x27;&lt;br&gt;Kinect open, LED green" style="rounded=1;arcSize=20;fillColor=#FFFFFF;strokeWidth=2;fontSize=13;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1180" y="320" width="230" height="82" as="geometry"/></mxCell><mxCell id="unk" value="&lt;b&gt;Unknown&lt;/b&gt;&lt;br&gt;&amp;#x27;Camera status unknown&amp;#x27;&lt;br&gt;image functions blocked" style="rounded=0;dashed=1;dashPattern=7 4;fillColor=#FFFFFF;strokeWidth=2;fontSize=13;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="760" y="640" width="300" height="82" as="geometry"/></mxCell><mxCell id="note5" value="Rules&lt;br&gt;• Default is Off; consent lasts one session.&lt;br&gt;• L1 and L2 keep frames in memory only;&lt;br&gt;   no code path writes images (C-02.1).&lt;br&gt;• Phone garment photos are user uploads,&lt;br&gt;   not camera capture." style="rounded=0;fillColor=#FFFFFF;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;fontSize=12;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1100" y="600" width="350" height="130" as="geometry"/></mxCell><mxCell id="lg0" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=20;fillColor=#FFFFFF;strokeWidth=2;fontSize=13;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40.0" y="810" width="64" height="24" as="geometry"/></mxCell><mxCell id="lg1" value="&lt;b&gt;&lt;/b&gt;" style="rounded=0;dashed=1;dashPattern=7 4;fillColor=#FFFFFF;strokeWidth=2;fontSize=13;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="506.6666666666667" y="810" width="64" height="24" as="geometry"/></mxCell><mxCell id="lg2" value="" style="ellipse;fillColor=#000000;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="995.3333333333334" y="811" width="20" height="20" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=none;rounded=0;strokeWidth=2;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;endArrow=block;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.4390;entryPerimeter=0;" edge="1" parent="1" source="start" target="off"><mxGeometry relative="1" as="geometry"><mxPoint x="72" y="356" as="sourcePoint"/><mxPoint x="340" y="356" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l0" value="boot, and every&lt;br&gt;new session" style="text;align=center;verticalAlign=top;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="145.5" y="316" width="109.0" height="38" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=none;rounded=0;strokeWidth=2;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;endArrow=block;exitX=1.0000;exitY=0.2439;exitPerimeter=0;entryX=0.0000;entryY=0.2439;entryPerimeter=0;" edge="1" parent="1" source="off" target="ask"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="340" as="sourcePoint"/><mxPoint x="760" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l1" value="try, measure, or gestures&lt;br&gt;requested" style="text;align=center;verticalAlign=top;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="577.5" y="298" width="175.0" height="38" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=none;rounded=0;strokeWidth=2;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;endArrow=block;exitX=0.0000;exitY=0.7805;exitPerimeter=0;entryX=1.0000;entryY=0.7805;entryPerimeter=0;" edge="1" parent="1" source="ask" target="off"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="384" as="sourcePoint"/><mxPoint x="570" y="384" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l2" value="declined, or no answer in 15 s /&lt;br&gt;log ConsentEvent; nothing captured" style="text;align=center;verticalAlign=top;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="547.8" y="406" width="234.39999999999998" height="38" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=none;rounded=0;strokeWidth=2;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;endArrow=block;exitX=1.0000;exitY=0.2439;exitPerimeter=0;entryX=0.0000;entryY=0.2439;entryPerimeter=0;" edge="1" parent="1" source="ask" target="on"><mxGeometry relative="1" as="geometry"><mxPoint x="990" y="340" as="sourcePoint"/><mxPoint x="1180" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l3" value="explicit &amp;#x27;Allow&amp;#x27; /&lt;br&gt;capture.enable; L1 confirms" style="text;align=center;verticalAlign=top;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="990.9" y="298" width="188.2" height="38" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=none;rounded=0;strokeWidth=2;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;endArrow=block;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryPerimeter=0;" edge="1" parent="1" source="on" target="off"><mxGeometry relative="1" as="geometry"><mxPoint x="1295" y="402" as="sourcePoint"/><mxPoint x="455" y="402" as="targetPoint"/><Array as="points"><mxPoint x="1295" y="500"/><mxPoint x="455" y="500"/></Array></mxGeometry></mxCell><mxCell id="l4" value="revoke (touch or voice), or session ends / capture.disable; L1 closes device" style="text;align=center;verticalAlign=top;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="619.2" y="478" width="511.59999999999997" height="22" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=none;rounded=0;strokeWidth=2;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;endArrow=block;dashed=1;dashPattern=9 6;exitX=0.5304;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="region" target="unk"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="560" as="sourcePoint"/><mxPoint x="910" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l5" value="no status reply in 2 s, or&lt;br&gt;reply contradicts expected state" style="text;align=right;verticalAlign=top;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="678.8" y="578" width="221.2" height="38" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=none;rounded=0;strokeWidth=2;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;endArrow=block;exitX=0.0000;exitY=0.7317;exitPerimeter=0;entryX=0.3478;entryY=1.0000;entryPerimeter=0;" edge="1" parent="1" source="unk" target="off"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="700" as="sourcePoint"/><mxPoint x="420" y="402" as="targetPoint"/><Array as="points"><mxPoint x="420" y="700"/></Array></mxGeometry></mxCell><mxCell id="l6" value="L1 verifies the Kinect is closed" style="text;align=center;verticalAlign=top;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="479.4" y="676" width="221.2" height="22" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=none;rounded=0;strokeWidth=2;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40.0" y="855" as="sourcePoint"/><mxPoint x="104.0" y="855" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=none;rounded=0;strokeWidth=2;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;endArrow=block;dashed=1;dashPattern=9 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="506.6666666666667" y="855" as="sourcePoint"/><mxPoint x="570.6666666666667" y="855" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t0" value="L8 owns the prompt and the on-glass indicator; L1 is the only component that can open the Kinect and does so only after capture.enable (I27)." style="text;align=left;verticalAlign=top;fontSize=13;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="128" width="1420" height="24" as="geometry"/></mxCell><mxCell id="t1" value="Legend" style="text;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="36" y="779" width="1414" height="25" as="geometry"/></mxCell><mxCell id="t2" value="State" style="text;align=left;verticalAlign=top;fontSize=12;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="118.0" y="813" width="1332.0" height="23" as="geometry"/></mxCell><mxCell id="t3" value="Error state" style="text;align=left;verticalAlign=top;fontSize=12;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="584.6666666666667" y="813" width="865.3333333333333" height="23" as="geometry"/></mxCell><mxCell id="t4" value="Start (first state on power-up)" style="text;align=left;verticalAlign=top;fontSize=12;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1051.3333333333335" y="813" width="398.6666666666665" height="23" as="geometry"/></mxCell><mxCell id="t5" value="Transition: trigger / action" style="text;align=left;verticalAlign=top;fontSize=12;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="118.0" y="847" width="1332.0" height="23" as="geometry"/></mxCell><mxCell id="t6" value="Error or timeout transition" style="text;align=left;verticalAlign=top;fontSize=12;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="584.6666666666667" y="847" width="865.3333333333333" height="23" as="geometry"/></mxCell><mxCell id="t7" value="Group: an arrow leaving it applies to every state inside" style="text;align=left;verticalAlign=top;fontSize=12;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1051.3333333333335" y="847" width="398.6666666666665" height="23" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>