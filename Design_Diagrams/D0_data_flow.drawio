 edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40.0" y="1250" as="sourcePoint"/><mxPoint x="100.0" y="1250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=none;html=1;fontFamily=Arial;rounded=0;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=12;fontSize=13;fontStyle=1;fontColor=#000000;labelBackgroundColor=#ffffff;startArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="516.6666666666667" y="1250" as="sourcePoint"/><mxPoint x="576.6666666666667" y="1250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t0" value="Smart Closet Mirror — D0 Data-Flow Diagram" style="text;html=1;fontFamily=Arial;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=25;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1200" height="38" as="geometry"/></mxCell><mxCell id="t1" value="Goal: turn a Gen 1 Mirror into a closet mirror that measures the user with a Kinect, shows their own&lt;br&gt;clothes and shop items on their body, and tells them what to wear today and whether a new piece is worth buying." style="text;html=1;fontFamily=Arial;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="59" width="1400" height="48" as="geometry"/></mxCell><mxCell id="t2" value="Basic input: the person in front of the glass (Kinect colour + depth, Mirror presence/voice), garment photos from the phone,&lt;br&gt;calendar and shop data.   Basic output: live try-on video and decision cards (today&amp;#x27;s outfit, buy/skip verdict) on the glass." style="text;html=1;fontFamily=Arial;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="108" width="1400" height="46" as="geometry"/></mxCell><mxCell id="t3" value="Flow A — Live try-on (continuous, every frame)" style="text;html=1;fontFamily=Arial;align=le