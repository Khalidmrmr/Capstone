=#000000;labelBackgroundColor=#ffffff;startArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="516.6666666666667" y="1070" as="sourcePoint"/><mxPoint x="576.6666666666667" y="1070" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e19" value="" style="edgeStyle=none;html=1;fontFamily=Arial;rounded=0;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=12;fontSize=13;fontStyle=1;fontColor=#000000;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="993.3333333333334" y="1070" as="sourcePoint"/><mxPoint x="1053.3333333333335" y="1070" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t0" value="Smart Closet Mirror — D0 Block Diagram" style="text;html=1;fontFamily=Arial;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=25;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1200" height="38" as="geometry"/></mxCell><mxCell id="t1" value="Goal: turn a Gen 1 Mirror into a closet mirror that measures the user with a Kinect, shows their own&lt;br&gt;clothes and shop items on their body, and tells them what to wear today and whether a new piece is worth buying." style="text;html=1;fontFamily=Arial;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="59" width="1400" height="48" as="geometry"/></mxCell><mxCell id="t2" value="Basic input: the person in front of the glass (Kinect colour + depth, Mirror presence/voice), garment photos from the phone,&lt;br&gt;calendar and shop data.   Basic output: live try-on video and decision cards (today&amp;#x27;s outfit, buy/skip verdict) on the glass." style="text;html=1;fontFamily=Arial;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="108" width="1400" height="46" as="geometry"/></mxCell><mxCell id="t3" value="Brain computer (Ubuntu PC)" style="text;html=1;fontFamily=Arial;align=right;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980.0" y="165" width="400" height="27" as="geometry"/></mxCell><mxCell id="t4" value="Legend" style="text;html=1;fontFamily=Arial;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="36" y="997" width="200" height="27" as="geometry"/></mxCell><mxCell id="t5" value="Component we build (layer Lx)" style="text;html=1;fontFamily=Arial;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="112.0" y="1029" width="396.6666666666667" height="25" as="geometry"/></mxCell><mxCell id="t6" value="External system / device we depend on" style="text;html=1;fontFamily=Arial;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="588.6666666666667" y="1029" width="396.6666666666667" height="25" as="geometry"/></mxCell><mxCell id="t7" value="Boundary: hardware platform or our computer" style="text;html=1;fontFamily=Arial;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1065.3333333333335" y="1029" width="396.6666666666667" height="25" as="geometry"/></mxCell><mxCell id="t8" value="Internal interface (message bus), arrow = data direction" style="text;html=1;fontFamily=Arial;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="112.0" y="1063" width="396.6666666666667" height="25" as="geometry"/></mxCell><mxCell id="t9" value="External interface (leaves the brain computer)" style="text;html=1;fontFamily=Arial;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="588.6666666666667" y="1063" width="396.6666666666667" height="25" as="geometry"/></mxCell><mxCell id="t10" value="Two-headed = request / response" style="text;html=1;fontFamily=Arial;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1065.3333333333335" y="1063" width="396.6666666666667" height="25" as="geometry"/></mxCell><mxCell id="t11" value="Shared plane (no direct lines; used by all)" style="text;html=1;fontFamily=Arial;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="112.0" y="1097" width="396.6666666666667" height="25" as="geometry"/></mxCell><mxCell id="t12" value="I-numbers match the Interface Specification table. Where two lines cross (I11 over I15) they are not connected." style="text;html=1;fontFamily=Arial;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="1135" width="1400" height="25" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>