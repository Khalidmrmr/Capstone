" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l2" value="PIN OK; card&lt;br&gt;ready ≤ 5 s" style="text;align=center;verticalAlign=top;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="655.4" y="354" width="89.19999999999999" height="38" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=none;rounded=0;strokeWidth=2;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;endArrow=block;dashed=1;dashPattern=9 6;exitX=1.0000;exitY=0.7222;exitPerimeter=0;entryX=0.0000;entryY=0.7222;entryPerimeter=0;" edge="1" parent="1" source="waking" target="home"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="432" as="sourcePoint"/><mxPoint x="760" y="432" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l3" value="5 s timeout:&lt;br&gt;Home without&lt;br&gt;outfit card" style="text;align=center;verticalAlign=top;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="655.4" y="461" width="89.19999999999999" height="54" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=none;rounded=0;strokeWidth=2;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;endArrow=block;exitX=0.2000;exitY=0.0000;exitPerimeter=0;entryX=0.2000;entryY=1.0000;entryPerimeter=0;" edge="1" parent="1" source="home" target="measuring"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="380" as="sourcePoint"/><mxPoint x="800" y="277" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l4" value="measure&lt;br&gt;[capture on]" style="text;align=right;verticalAlign=top;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontColor=#0