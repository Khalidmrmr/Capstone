<mxfile host="app.diagrams.net"><diagram name="Fig D2-3: &#x27;Buy or skip?&#x27; decision flow with error paths" id="D2_fig3_buy_or_skip_errors"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1480" pageHeight="1110"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hdr" value="&lt;b&gt;Smart Closet Mirror — Fig D2-3: &amp;#x27;Buy or skip?&amp;#x27; decision flow with error paths&lt;/b&gt;&lt;br&gt;Goal: Turn a Gen 1 Mirror into a closet mirror that measures the user with a Kinect, shows their own clothes and shop items on their body, and tells them what to wear today and whether a new piece is worth buying." style="text;align=left;verticalAlign=top;fontSize=16;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1420" height="90" as="geometry"/></mxCell><mxCell id="legend" value="" style="rounded=0;fillColor=#FFFFFF;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;fontSize=12;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="925" width="1440" height="145" as="geometry"/></mxCell><mxCell id="ask" value="&lt;b&gt;User asks&lt;/b&gt;&lt;br&gt;&amp;#x27;buy or skip?&amp;#x27;&lt;br&gt;L8 → L6 (I17)" style="rounded=1;arcSize=20;fillColor=#FFFFFF;strokeWidth=2;fontSize=13;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="210" width="190" height="84" as="geometry"/></mxCell><mxCell id="load" value="&lt;b&gt;L6 loads item&lt;/b&gt;&lt;br&gt;wardrobe.get (I11)" style="rounded=1;arcSize=20;fillColor=#FFFFFF;strokeWidth=2;fontSize=13;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="255" y="210" width="190" height="84" as="geometry"/></mxCell><mxCell id="found" value="&lt;b&gt;Found and&lt;/b&gt;&lt;br&gt;complete?" style="rhombus;fillColor=#FFFFFF;strokeWidth=2;fontSize=12;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="495" y="197" width="170" height="110" as="geometry"/></mxCell><mxCell id="prof" value="&lt;b&gt;Current&lt;/b&gt;&lt;br&gt;profile OK?" style="rhombus;fillColor=#FFFFFF;strokeWidth=2;fontSize=12;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="730" y="197" width="170" height="110" as="geometry"/></mxCell><mxCell id="fit" value="&lt;b&gt;L5 fit check&lt;/b&gt;&lt;br&gt;tryon.request (I12)" style="rounded=1;arcSize=20;fillColor=#FFFFFF;strokeWidth=2;fontSize=13;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="960" y="210" width="190" height="84" as="geometry"/></mxCell><mxCell id="intime" value="&lt;b&gt;Fit back&lt;/b&gt;&lt;br&gt;within 1.5 s?" style="rhombus;fillColor=#FFFFFF;strokeWidth=2;fontSize=12;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1205" y="197" width="170" height="110" as="geometry"/></mxCell><mxCell id="price" value="&lt;b&gt;L7 refreshes price&lt;/b&gt;&lt;br&gt;ctx.products (I14b)" style="rounded=1;arcSize=20;fillColor=#FFFFFF;strokeWidth=2;fontSize=13;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1195" y="585" width="190" height="84" as="geometry"/></mxCell><mxCell id="fresh" value="&lt;b&gt;Price fresh?&lt;/b&gt;" style="rhombus;fillColor=#FFFFFF;strokeWidth=2;fontSize=12;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="960" y="572" width="170" height="110" as="geometry"/></mxCell><mxCell id="verdict" value="&lt;b&gt;L6 verdict&lt;/b&gt;&lt;br&gt;algorithm A5" style="rounded=1;arcSize=20;fillColor=#FFFFFF;strokeWidth=2;fontSize=13;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="720" y="585" width="190" height="84" as="geometry"/></mxCell><mxCell id="deliv" value="&lt;b&gt;L8 socket&lt;/b&gt;&lt;br&gt;connected?" style="rhombus;fillColor=#FFFFFF;strokeWidth=2;fontSize=12;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="485" y="572" width="170" height="110" as="geometry"/></mxCell><mxCell id="shown" value="&lt;b&gt;Card on glass&lt;/b&gt;&lt;br&gt;≤ 2 s after asking" style="rounded=1;arcSize=20;fillColor=#FFFFFF;strokeWidth=4;fontSize=13;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="230" y="585" width="200" height="84" as="geometry"/></mxCell><mxCell id="x_found" value="&lt;b&gt;SURFACE ERROR · L6&lt;/b&gt;&lt;br&gt;card: &amp;#x27;item no longer&lt;br&gt;available&amp;#x27;. Ends this&lt;br&gt;request (not recoverable)." style="rounded=0;dashed=1;dashPattern=7 4;fillColor=#FFFFFF;strokeWidth=2;fontSize=13;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="455" y="395" width="250" height="105" as="geometry"/></mxCell><mxCell id="x_prof" value="&lt;b&gt;RECOVER · L8 + L2&lt;/b&gt;&lt;br&gt;go to Measuring&lt;br&gt;(Fig D2-2); ask again&lt;br&gt;when done." style="rounded=0;dashed=1;dashPattern=7 4;fillColor=#FFFFFF;strokeWidth=2;fontSize=13;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="720" y="395" width="210" height="105" as="geometry"/></mxCell><mxCell id="x_time" value="&lt;b&gt;DEGRADE · L6&lt;/b&gt;&lt;br&gt;decide without fit;&lt;br&gt;card says &amp;#x27;fit pending&amp;#x27;;&lt;br&gt;late report updates it." style="rounded=0;dashed=1;dashPattern=7 4;fillColor=#FFFFFF;strokeWidth=2;fontSize=13;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1165" y="395" width="250" height="105" as="geometry"/></mxCell><mxCell id="x_price" value="&lt;b&gt;FALL BACK · L7 → L6&lt;/b&gt;&lt;br&gt;use cached price; card&lt;br&gt;says &amp;#x27;price from &amp;lt;date&amp;gt;&amp;#x27;." style="rounded=0;dashed=1;dashPattern=7 4;fillColor=#FFFFFF;strokeWidth=2;fontSize=13;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="925" y="790" width="250" height="105" as="geometry"/></mxCell><mxCell id="x_deliv" value="&lt;b&gt;RETRY · Mirror + L8&lt;/b&gt;&lt;br&gt;WebView reconnects every&lt;br&gt;2 s; L8 resends the card.&lt;br&gt;Gives up at 30 s → Asleep." style="rounded=0;dashed=1;dashPattern=7 4;fillColor=#FFFFFF;strokeWidth=2;fontSize=13;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="445" y="790" width="250" height="105" as="geometry"/></mxCell><mxCell id="lg0" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=20;fillColor=#FFFFFF;strokeWidth=2;fontSize=13;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40.0" y="965" width="64" height="24" as="geometry"/></mxCell><mxCell id="lg1" value="&lt;b&gt;&lt;/b&gt;" style="rhombus;fillColor=#FFFFFF;strokeWidth=2;fontSize=12;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="506.6666666666667" y="965" width="64" height="24" as="geometry"/></mxCell><mxCell id="lg2" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;arcSize=20;fillColor=#FFFFFF;strokeWidth=4;fontSize=13;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="973.3333333333334" y="965" width="64" height="24" as="geometry"/></mxCell><mxCell id="lg3" value="&lt;b&gt;&lt;/b&gt;" style="rounded=0;dashed=1;dashPattern=7 4;fillColor=#FFFFFF;strokeWidth=2;fontSize=13;fontFamily=Arial